{
  "name": "@overlock/backend",
  "version": "0.1.0",
  "description": "Production-grade inventory allocation state engine with TSOA, PostgreSQL row-locking, and Redis idempotency",
  "main": "build/src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsoa spec-and-routes && tsc",
    "dev": "concurrently \"nodemon\" \"tsoa spec-and-routes --watch\"",
    "start": "node build/src/server.js",
    "tsoa:gen": "tsoa spec-and-routes",
    "test": "jest --runInBand",
    "test:integration": "jest --config jest.integration.config.ts --runInBand",
    "db:migrate": "node build/src/config/migrate.js"
  },
  "keywords": [
    "tsoa",
    "openapi",
    "inventory",
    "allocation",
    "state-engine",
    "postgresql",
    "redis",
    "idempotency"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tsoa/runtime": "^7.0.0-alpha.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^7.0.0-alpha.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.3",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
